# Copy to .env.local for local dev.
# On Vercel: Project Settings → Environment Variables → add the same keys.

# Private login (required in production)
AUTH_USERNAME=owner
AUTH_PASSWORD=your-strong-password
AUTH_SECRET=generate-a-long-random-secret-at-least-32-chars

# Cloud sync (Vercel Blob — create a store in Vercel → Storage → Blob, then link to the project)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token

# AI coach
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Email reminders (Resend — https://resend.com)
REMINDER_EMAIL=you@gmail.com
RESEND_API_KEY=re_your_resend_key
RESEND_FROM=onboarding@resend.dev

# Optional Gmail SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
